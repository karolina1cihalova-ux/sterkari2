---
import { NAV } from '../data/sterky';
import { sterkyRooms } from '../lib/sterky';
import Arrow from './Arrow.astro';

// "Stěrky" opens a small list of rooms that jump to /#sterky-<room>
const rooms = await sterkyRooms();
const hasRooms = (href: string) => href === '/#sterky' && rooms.length > 0;
---
<header id="hdr" class="hdr sticky z-50 border-b border-transparent bg-white/95 backdrop-blur-md backdrop-saturate-[1.2] transition-[border-color,box-shadow] duration-200 [&.scrolled]:border-line [&.scrolled]:shadow-[0_10px_24px_-18px_rgb(60_40_25/0.35)]">
  <div class="hdr-in wrap grid min-h-[73px] grid-cols-[1fr_auto_1fr] items-center gap-6 py-3 max-[560px]:grid-cols-[1fr_auto_auto] max-[560px]:gap-2 max-[360px]:gap-1.5">
    <a class="justify-self-start text-[21.6px] font-extrabold tracking-[-0.04em] text-black no-underline" href="/">STĚRKAŘI.</a>

    <nav class="hdr-nav" aria-label="Hlavní menu">
      <ul class="m-0 flex list-none items-center p-0">
        {NAV.map((item, i) => (
          <li class="flex items-center">
            {i > 0 && <span class="mx-3 font-normal text-[#a1a1a1]" aria-hidden="true">·</span>}
            {hasRooms(item.href) ? (
              <div class="has-dd relative">
                <a class="menu-label inline-flex items-center gap-1.5 mr-[-0.2em] transition-colors duration-150 hover:text-accent" href={item.href} aria-haspopup="true">
                  {item.label}
                  <svg class="chev" width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <!-- pt-3 bridges the gap so the pointer can travel into the list -->
                <div class="dd absolute top-full left-1/2 z-10 pt-3">
                  <ul class="m-0 grid min-w-[200px] list-none gap-0.5 rounded-card bg-white p-2 shadow-float ring-1 ring-line" aria-label="Stěrky podle místnosti">
                    {rooms.map((r) => (
                      <li><a class="dd-link flex items-center justify-between gap-4 rounded-lg px-3 py-2 text-sm font-semibold text-ink no-underline" href={`/#sterky-${r.id}`}>{r.label}<span class="text-xs font-medium text-muted tabular-nums">{r.count}</span></a></li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a class="menu-label mr-[-0.2em] transition-colors duration-150 hover:text-accent" href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <button
      class="burger hidden size-11 cursor-pointer place-items-center rounded-lg border border-[#ddd7cd] bg-transparent text-black hover:border-black max-[360px]:size-[38px]"
      id="burger"
      type="button"
      aria-expanded="false"
      aria-controls="menuPanel"
      aria-label="Otevřít menu"
    >
      <span></span><span></span>
    </button>

    <a class="btn btn-dark justify-self-end py-3 max-[420px]:px-4 max-[360px]:px-3 max-[360px]:tracking-normal" href="/#kontakt">Chci na workshop<Arrow class="max-[420px]:hidden" /></a>
  </div>

  <nav class="menu-panel absolute inset-x-0 top-full border-b border-line bg-white shadow-[0_24px_40px_-28px_rgba(26,26,26,0.35)]" id="menuPanel" aria-label="Menu">
    <ul class="m-0 grid list-none justify-items-center p-0 pt-2 pb-5">
      {NAV.map((item) => (
        <li class="grid justify-items-center">
          <a class="menu-label block px-6 py-3.5 mr-[-0.2em] hover:text-accent" href={item.href}>{item.label}</a>
          {hasRooms(item.href) && (
            <span class="-mt-1.5 mb-1.5 flex max-w-[340px] flex-wrap justify-center gap-x-1 gap-y-0.5 px-4">
              {rooms.map((r) => (
                <a class="rounded-md px-2 py-1 text-[13px] font-semibold text-muted no-underline hover:text-accent" href={`/#sterky-${r.id}`}>{r.label}</a>
              ))}
            </span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .hdr { top: env(safe-area-inset-top, 0px); }

  /* Full menu whenever it fits; the script adds .compact only when it doesn't */
  .hdr:not(.compact) .hdr-in { display: flex; justify-content: space-between; } /* equal space logo ↔ menu ↔ button */
  .hdr:not(.compact) .menu-panel { display: none; }
  .hdr.compact .hdr-nav { display: none; }
  .hdr.compact .burger { display: inline-grid; }

  /* Burger: two lines that morph into an ✕ */
  .burger { transition: transform 160ms var(--ease-hover), border-color 220ms var(--ease-hover), background-color 220ms var(--ease-hover); }
  @media (hover: hover) and (pointer: fine) { .burger:hover { background-color: var(--color-paper); } }
  .burger:active { transform: scale(0.95); }
  .burger span { grid-area: 1 / 1; width: 18px; height: 2px; border-radius: 2px; background: currentColor; transition: transform 250ms var(--ease-out-strong); }
  .burger span:first-child { transform: translateY(-4px); }
  .burger span:last-child { transform: translateY(4px); }
  .burger[aria-expanded='true'] span:first-child { transform: rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: rotate(-45deg); }

  /* "Stěrky" room list: opens on hover (mouse) or keyboard focus, closes with the same curve */
  .dd {
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 180ms var(--ease-hover), transform 180ms var(--ease-hover), visibility 0s linear 180ms;
  }
  .has-dd:focus-within .dd { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
  @media (hover: hover) and (pointer: fine) {
    .has-dd:hover .dd { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
    .dd-link:hover { background-color: var(--color-paper); }
  }
  .has-dd.closed .dd { opacity: 0; visibility: hidden; transition-delay: 0s; }
  .chev { transition: transform 180ms var(--ease-hover); }
  .has-dd:focus-within .chev { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) { .has-dd:hover .chev { transform: rotate(180deg); } }
  .dd-link { transition: background-color 160ms var(--ease-hover); }

  /* Hamburger panel: revealed from the top edge, links follow in a short stagger */
  .menu-panel {
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 280ms var(--ease-out-strong), visibility 0s linear 280ms;
  }
  .menu-panel.open { clip-path: inset(0 0 -40px 0); visibility: visible; transition: clip-path 280ms var(--ease-out-strong), visibility 0s; }
  .menu-panel a { opacity: 0; transform: translateY(-6px); transition: opacity 200ms ease, transform 250ms var(--ease-out-strong), color 150ms ease; }
  .menu-panel.open a { opacity: 1; transform: none; }
  .menu-panel.open li:nth-child(2) a { transition-delay: 30ms; }
  .menu-panel.open li:nth-child(3) a { transition-delay: 60ms; }
  .menu-panel.open li:nth-child(4) a { transition-delay: 90ms; }
  .menu-panel.open li:nth-child(5) a { transition-delay: 120ms; }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel, .menu-panel.open, .burger span { transition: none; }
    .menu-panel a { transform: none; transition: opacity 150ms ease; }
    .burger:active { transform: none; }
    .dd, .chev { transition: none; }
  }
</style>

<script>
  const hdr = document.getElementById('hdr')!;
  const hdrIn = hdr.querySelector<HTMLElement>('.hdr-in')!;
  const navUl = hdr.querySelector<HTMLElement>('.hdr-nav ul')!;
  const logo = hdr.querySelector<HTMLElement>('.hdr-in > a')!;
  const cta = hdr.querySelector<HTMLElement>('.hdr-in > .btn')!;
  const burger = document.getElementById('burger')!;
  const panel = document.getElementById('menuPanel')!;
  const MIN_GAP = 40;

  // Thin border once the page scrolls
  const onScroll = () => hdr.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Hamburger
  const setMenu = (open: boolean) => {
    panel.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
  };
  burger.addEventListener('click', () => setMenu(!panel.classList.contains('open')));
  panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  document.addEventListener('click', (e) => {
    if (panel.classList.contains('open') && !(e.target as HTMLElement).closest('#hdr')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('open')) { setMenu(false); burger.focus(); }
  });

  // Room list: close it after a room is picked (the pointer may still be over it)
  hdr.querySelectorAll<HTMLElement>('.has-dd').forEach((dd) => {
    dd.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.dd-link')) return;
      dd.classList.add('closed');
      (document.activeElement as HTMLElement | null)?.blur();
    });
    dd.addEventListener('mouseleave', () => dd.classList.remove('closed'));
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') (document.activeElement as HTMLElement | null)?.blur();
    });
  });

  // Switch to the hamburger only when logo + menu + button no longer fit with breathing room
  const fitHeader = () => {
    const wasCompact = hdr.classList.contains('compact');
    hdr.classList.remove('compact'); // measure the full layout (same frame, never painted)
    const cs = getComputedStyle(hdrIn);
    const avail = hdrIn.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    // Sum of the menu items (not scrollWidth: the hidden room list would count too)
    const navWidth = [...navUl.children].reduce((w, li) => w + (li as HTMLElement).offsetWidth, 0);
    const need = logo.offsetWidth + navWidth + cta.offsetWidth + MIN_GAP * 2;
    const compact = need > avail;
    hdr.classList.toggle('compact', compact);
    if (wasCompact && !compact) setMenu(false);
  };
  let queued = false;
  window.addEventListener('resize', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; fitHeader(); });
  });
  fitHeader();
  document.fonts?.ready.then(fitHeader);
</script>
