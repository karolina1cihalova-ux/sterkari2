---
/**
 * Stěrky by room: pick a room, see the structures that fit it.
 * Structures = Inspirace entries with a cover photo and no generated `structure`;
 * rooms come from their `fits` list. Deep link: /#sterky-<room> (used by the header dropdown).
 */
import { Image } from 'astro:assets';
import { cz, LEVEL_LABEL, fitsLabel } from '../data/sterky';
import { getSterky, sterkyRooms } from '../lib/sterky';

const items = await getSterky();
const rooms = await sterkyRooms();
const first = rooms[0];
---
{first && (
<section class="bg-paper py-24 max-[900px]:py-[72px]" id="sterky">
  <div class="wrap">
    <div class="sec-head">
      <h2>Stěrky</h2>
      <p>{cz('Vyberte místnost a podívejte se, které struktury se do ní hodí.')}</p>
    </div>

    <div class="-mx-3 mb-5 overflow-x-auto px-3 pt-1 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div class="relative inline-flex gap-1 rounded-xl bg-white p-1 shadow-card" role="tablist" aria-label="Místnost" id="roomTabs">
        <span class="tab-ind absolute inset-y-1 left-0 rounded-lg bg-ink" id="roomInd" aria-hidden="true"></span>
        {rooms.map((r, i) => (
          <button
            class="tab relative z-[1] inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-lg border-0 bg-transparent px-[18px] py-2.5 text-sm font-semibold text-ink aria-selected:text-white"
            type="button"
            role="tab"
            id={`room-${r.id}`}
            aria-controls="sterkyGrid"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-room={r.id}
          >{r.label}<span class="cnt text-xs font-medium tabular-nums">{r.count}</span></button>
        ))}
      </div>
    </div>

    <ul class="m-0 grid list-none grid-cols-2 gap-x-3 gap-y-7 p-0 min-[561px]:gap-x-5 min-[901px]:grid-cols-3" id="sterkyGrid" role="tabpanel" aria-labelledby={`room-${first.id}`}>
      {items.map((it) => (
        <li class="sk" data-fits={it.data.fits.join(' ')} hidden={!it.data.fits.includes(first.id)}>
          <a class="sk-link grid gap-3 text-inherit no-underline" href={`/inspirace/${it.id}/`}>
            <span class="frame relative block aspect-[4/5] overflow-hidden rounded-card bg-line shadow-card">
              <span class="photo block h-full w-full">
                <Image src={it.data.cover!} alt={it.data.title} widths={[400, 700, 1000]} sizes="(min-width: 901px) 33vw, 50vw" class="block h-full w-full object-cover" />
              </span>
              <span class="go absolute right-2 bottom-2 grid size-8 place-items-center rounded-full bg-white text-ink shadow-[0_4px_14px_rgba(0,0,0,0.15)] min-[561px]:right-3 min-[561px]:bottom-3 min-[561px]:size-10" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </span>
            <span class="grid gap-1.5">
              <b class="text-base leading-snug font-bold text-ink min-[561px]:text-lg">{it.data.title}</b>
              <span class="line-clamp-2 text-sm max-[560px]:hidden">{cz(it.data.summary)}</span>
              {it.data.level && (
                <span class="flex items-center gap-2 text-[13px] text-muted">
                  <span class="inline-flex gap-1" aria-hidden="true">
                    {[1, 2, 3].map((k) => <i class:list={['size-2 rounded-full', k <= it.data.level! ? 'bg-accent' : 'bg-line']}></i>)}
                  </span>
                  Náročnost: {LEVEL_LABEL[it.data.level]}
                </span>
              )}
              {it.data.fits.length > 0 && <span class="text-[13px] text-muted max-[560px]:hidden">Kam se hodí: {fitsLabel(it.data.fits).toLowerCase()}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-[13px] text-muted">{cz('Fotky jsou ze skutečných realizací. Odstín a postup doladíme spolu na workshopu.')}</p>
  </div>
</section>
)}

<style>
  .tab-ind { transition: transform 300ms var(--ease-out-strong), width 300ms var(--ease-out-strong); }
  .tab { transition: color 220ms var(--ease-hover), background-color 220ms var(--ease-hover), transform 160ms var(--ease-hover); }
  .tab .cnt { opacity: 0.55; }
  @media (hover: hover) and (pointer: fine) { .tab:not([aria-selected='true']):hover { background-color: var(--color-paper); } }
  .tab:active { transform: scale(0.97); }

  /* Card: photo leans in, shadow deepens, arrow nudges (mouse only) */
  .frame { transition: box-shadow 300ms var(--ease-hover); }
  .photo { transition: transform 400ms var(--ease-out-strong); }
  .go { transition: transform 250ms var(--ease-out-strong); }
  @media (hover: hover) and (pointer: fine) {
    .sk-link:hover .frame { box-shadow: var(--shadow-float); }
    .sk-link:hover .photo { transform: scale(1.03); }
    .sk-link:hover .go { transform: translateX(3px); }
  }
  .sk-link:active .photo { transform: scale(0.99); transition-duration: 160ms; }

  @media (prefers-reduced-motion: reduce) {
    .tab-ind, .photo, .go { transition: none; }
    .tab:active, .sk-link:hover .photo, .sk-link:hover .go, .sk-link:active .photo { transform: none; }
  }
</style>

<script>
  const tabsEl = document.getElementById('roomTabs');
  if (tabsEl) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...tabsEl.querySelectorAll<HTMLButtonElement>('.tab')];
    const ind = document.getElementById('roomInd')!;
    const grid = document.getElementById('sterkyGrid')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.sk')];
    let current = 0;

    const moveInd = () => {
      const t = tabs[current];
      ind.style.width = `${t.offsetWidth}px`;
      ind.style.transform = `translateX(${t.offsetLeft}px)`;
    };

    const select = (i: number, animate: boolean) => {
      current = i;
      const room = tabs[i].dataset.room!;
      tabs.forEach((b, k) => {
        b.setAttribute('aria-selected', String(k === i));
        b.tabIndex = k === i ? 0 : -1;
      });
      // Keep the chosen tab visible in the row, scrolling the row only (never the page)
      const row = tabsEl.parentElement!;
      const t = tabs[i];
      if (t.offsetLeft < row.scrollLeft || t.offsetLeft + t.offsetWidth > row.scrollLeft + row.clientWidth) {
        row.scrollTo({ left: t.offsetLeft - 12, behavior: reduce ? 'auto' : 'smooth' });
      }
      grid.setAttribute('aria-labelledby', tabs[i].id);
      moveInd();
      const shown = cards.filter((c) => {
        const on = c.dataset.fits!.split(' ').includes(room);
        c.hidden = !on;
        return on;
      });
      // Short stagger on the cards of the chosen room
      if (animate && !reduce) shown.forEach((c, k) => c.animate(
        [{ opacity: 0, transform: 'translateY(8px) scale(0.98)' }, { opacity: 1, transform: 'none' }],
        { duration: 300, delay: k * 50, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' },
      ));
    };

    const byRoom = (room: string) => tabs.findIndex((t) => t.dataset.room === room);

    tabs.forEach((t, i) => t.addEventListener('click', () => {
      if (i === current) return;
      select(i, true);
      history.replaceState(null, '', `#sterky-${t.dataset.room}`);
    }));
    tabsEl.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      select((current + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
      tabs[current].focus();
    });

    // Deep link from the header dropdown: /#sterky-koupelna
    const fromHash = () => {
      const m = location.hash.match(/^#sterky-([a-z]+)$/);
      if (!m) return;
      const i = byRoom(m[1]);
      if (i < 0) return;
      select(i, i !== current);
      document.getElementById('sterky')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    };
    window.addEventListener('hashchange', fromHash);

    window.addEventListener('resize', moveInd);
    document.fonts?.ready.then(moveInd);
    moveInd();
    fromHash();
  }
</script>
