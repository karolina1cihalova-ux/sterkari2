---
/**
 * Stěrky: the real structures, one tab each, with the real photo.
 * Source: every Inspirace entry that has a cover photo and no generated `structure`
 * (add a new one there and it shows up here automatically).
 */
import Arrow from './Arrow.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { cz, LEVEL_LABEL } from '../data/sterky';

const photos = (await getCollection('inspirace'))
  .filter((e) => e.data.cover && !e.data.structure)
  .sort((a, b) => a.data.order - b.data.order);
const first = photos[0];
---
{first && (
<section class="bg-paper py-24 max-[900px]:py-[72px]" id="sterky">
  <div class="wrap">
    <div class="sec-head">
      <h2>Stěrky</h2>
      <p>{cz('Vyberte si strukturu, která se vám líbí. Na workshopu si ji vyzkoušíte na vzorku.')}</p>
    </div>

    <div class="-mx-3 mb-5 overflow-x-auto px-3 pt-1 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div class="relative inline-flex gap-1 rounded-xl bg-white p-1 shadow-card" role="tablist" aria-label="Struktura stěrky" id="tabs">
        <span class="tab-ind absolute inset-y-1 left-0 rounded-lg bg-ink" id="tabInd" aria-hidden="true"></span>
        {photos.map((p, i) => (
          <button
            class="tab relative z-[1] cursor-pointer whitespace-nowrap rounded-lg border-0 bg-transparent px-[18px] py-2.5 text-sm font-semibold text-ink aria-selected:text-white"
            type="button"
            role="tab"
            id={`tab-${p.id}`}
            aria-controls="panel"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-id={p.id}
            data-name={p.data.title}
            data-desc={cz(p.data.summary)}
            data-suits={p.data.suits ?? ''}
            data-level={p.data.level ?? 0}
          >{p.data.title}</button>
        ))}
      </div>
    </div>

    <div class="grid items-start gap-9 min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] min-[901px]:gap-12">
      <div class="relative aspect-[4/3] max-w-full overflow-hidden rounded-card bg-line shadow-float" id="preview" aria-hidden="true">
        {photos.map((p, i) => (
          <Image src={p.data.cover!} alt="" widths={[600, 900, 1300]} sizes="(min-width: 901px) 55vw, 100vw" class:list={['pv-photo absolute inset-0 h-full w-full object-cover', i === 0 && 'on']} />
        ))}
        <span class="wall-tag" id="pvTag">{first.data.title}</span>
      </div>

      <div class="grid min-w-0 gap-[22px]" role="tabpanel" id="panel" aria-labelledby={`tab-${first.id}`}>
        <h3 class="text-[30px] leading-[1.1] font-bold tracking-[-0.02em]" id="sName">{first.data.title}</h3>
        <p class="text-[16.5px]" id="sDesc">{cz(first.data.summary)}</p>
        <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 border-y border-line py-4 text-[14.5px]">
          <div class="contents" id="rowSuits" hidden={!first.data.suits}>
            <dt class="text-muted">Kam se hodí</dt><dd class="m-0 font-medium text-ink" id="sSuits">{first.data.suits}</dd>
          </div>
          <div class="contents" id="rowLevel" hidden={!first.data.level}>
            <dt class="text-muted">Náročnost</dt>
            <dd class="m-0 font-medium text-ink">
              <span class="mr-2 inline-flex gap-1 align-middle" id="sDots" aria-hidden="true">
                {[1, 2, 3].map((k) => <i class:list={['size-2 rounded-full', k <= (first.data.level ?? 0) ? 'bg-accent' : 'bg-line']}></i>)}
              </span><span id="sLevel">{LEVEL_LABEL[first.data.level ?? 0]}</span>
            </dd>
          </div>
        </dl>
        <a class="justify-self-start text-sm font-semibold text-ink underline decoration-accent underline-offset-4" id="sLink" href={`/inspirace/${first.id}/`}>Prohlédnout realizaci</a>
        <div class="flex flex-wrap items-center gap-3 border-t border-line pt-6">
          <button class="btn btn-dark" type="button" id="pickBtn">Chci tuhle stěrku<Arrow /></button>
          <span class="text-[13px] text-muted">{cz('Skutečná realizace. Odstín a postup doladíme spolu na workshopu.')}</span>
        </div>
      </div>
    </div>
  </div>
</section>
)}

<style>
  .tab-ind { transition: transform 300ms var(--ease-out-strong), width 300ms var(--ease-out-strong); }
  .tab { transition: color 220ms var(--ease-hover), background-color 220ms var(--ease-hover), transform 160ms var(--ease-hover); }
  @media (hover: hover) and (pointer: fine) { .tab:not([aria-selected='true']):hover { background-color: var(--color-paper); } }
  .tab:active { transform: scale(0.97); }
  /* Only the chosen photo is visible */
  .pv-photo { opacity: 0; }
  .pv-photo.on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .tab-ind { transition: none; }
    .tab:active { transform: none; }
  }
</style>

<script>
  import { LEVEL_LABEL } from '../data/sterky';

  const tabsEl = document.getElementById('tabs');
  if (tabsEl) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...tabsEl.querySelectorAll<HTMLButtonElement>('.tab')];
    const ind = document.getElementById('tabInd')!;
    const preview = document.getElementById('preview')!;
    const imgs = [...preview.querySelectorAll<HTMLImageElement>('.pv-photo')];
    const $ = (id: string) => document.getElementById(id)!;
    let current = 0;

    const moveInd = () => {
      const t = tabs[current];
      ind.style.width = `${t.offsetWidth}px`;
      ind.style.transform = `translateX(${t.offsetLeft}px)`;
    };

    // Blur masks the switch between two photos
    const settle = () => {
      if (reduce) return;
      preview.animate([{ filter: 'blur(6px)', opacity: 0.75 }, { filter: 'blur(0px)', opacity: 1 }], {
        duration: 280,
        easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
      });
    };

    const select = (i: number) => {
      if (i === current) return;
      current = i;
      const t = tabs[i];
      tabs.forEach((b, k) => {
        b.setAttribute('aria-selected', String(k === i));
        b.tabIndex = k === i ? 0 : -1;
      });
      t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      moveInd();
      imgs.forEach((img, k) => img.classList.toggle('on', k === i));
      $('panel').setAttribute('aria-labelledby', t.id);
      $('pvTag').textContent = t.dataset.name!;
      $('sName').textContent = t.dataset.name!;
      $('sDesc').textContent = t.dataset.desc!;
      $('sLink').setAttribute('href', `/inspirace/${t.dataset.id}/`);
      const level = Number(t.dataset.level);
      $('rowSuits').hidden = !t.dataset.suits;
      $('sSuits').textContent = t.dataset.suits!;
      $('rowLevel').hidden = !level;
      $('sLevel').textContent = LEVEL_LABEL[level] ?? '';
      [...$('sDots').children].forEach((d, k) => {
        d.classList.toggle('bg-accent', k < level);
        d.classList.toggle('bg-line', k >= level);
      });
      settle();
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    tabsEl.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      select((current + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length);
      tabs[current].focus();
    });

    // "Chci tuhle stěrku" → attach the choice (name + photo) to the booking form
    $('pickBtn').addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('sterka-pick', {
        detail: { name: tabs[current].dataset.name, img: imgs[current].currentSrc },
      }));
    });

    window.addEventListener('resize', moveInd);
    document.fonts?.ready.then(moveInd);
    moveInd();
  }
</script>
