---
/**
 * Hero wall: a bare, rough wall gets plastered by one trowel stroke on load.
 * The finished layer is revealed behind a slanted edge that the trowel rides along.
 * No JS / reduced motion: the finished wall is simply shown.
 */
import Wall from './Wall.astro';
---
<div class="tr relative h-[clamp(220px,30vw,380px)] overflow-hidden rounded-card" id="trowelWall" aria-hidden="true">
  <!-- Bare wall (podklad) -->
  <Wall shade="#DCD6CC" structure="plain" />
  <!-- Finished stucco -->
  <div class="tr-finish absolute inset-0">
    <Wall shade="#C4785A" structure="tadelakt" />
    <span class="tr-sheen absolute inset-0"></span>
  </div>

  <!-- Trowel (seen from above): steel blade, wooden handle -->
  <div class="tr-trowel pointer-events-none absolute top-1/2 left-0">
    <div class="tr-hand">
      <svg viewBox="0 0 200 120" class="block w-full" fill="none">
        <defs>
          <linearGradient id="trBlade" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#F4F4F2" />
            <stop offset="0.45" stop-color="#C9CBCC" />
            <stop offset="0.7" stop-color="#E6E7E6" />
            <stop offset="1" stop-color="#A9ACAE" />
          </linearGradient>
          <linearGradient id="trWood" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#A86B45" />
            <stop offset="1" stop-color="#7A4A2E" />
          </linearGradient>
        </defs>
        <!-- soft shadow on the wall -->
        <rect x="14" y="30" width="176" height="80" rx="14" fill="rgb(40 25 15 / 0.22)" filter="blur(6px)" />
        <!-- blade -->
        <rect x="8" y="22" width="176" height="80" rx="12" fill="url(#trBlade)" stroke="#8E9193" stroke-width="1.5" />
        <path d="M20 30h150" stroke="#fff" stroke-opacity="0.7" stroke-width="2" stroke-linecap="round" />
        <!-- tang -->
        <rect x="82" y="56" width="28" height="12" rx="3" fill="#7E8285" />
        <!-- handle -->
        <rect x="46" y="44" width="100" height="36" rx="18" fill="url(#trWood)" />
        <path d="M60 52h70" stroke="#fff" stroke-opacity="0.25" stroke-width="3" stroke-linecap="round" />
      </svg>
    </div>
  </div>

  <span class="wall-tag">Tadelakt · Teplá terakota · ilustrační</span>
</div>

<!-- Arm the reveal before first paint, so the finished wall never flashes -->
<script is:inline>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.getElementById('trowelWall').classList.add('armed');
</script>

<style>
  .tr-trowel { width: clamp(130px, 19vw, 240px); opacity: 0; }
  .tr-hand { transform: translateY(-50%) rotate(-8deg); transform-origin: 50% 50%; }
  .tr.armed .tr-finish { clip-path: polygon(0 0, -12% 0, -24% 100%, 0 100%); }
  .tr-sheen {
    background: linear-gradient(105deg, transparent 35%, rgb(255 240 225 / 0.35) 50%, transparent 65%) no-repeat;
    background-size: 250% 100%;
    background-position: 150% 0;
  }
</style>

<script>
  const wall = document.getElementById('trowelWall')!;
  const finish = wall.querySelector<HTMLElement>('.tr-finish')!;
  const trowel = wall.querySelector<HTMLElement>('.tr-trowel')!;
  const hand = wall.querySelector<HTMLElement>('.tr-hand')!;
  const sheen = wall.querySelector<HTMLElement>('.tr-sheen')!;

  // A hand stroke: eases in, glides, eases out
  const STROKE = 'cubic-bezier(0.6, 0.05, 0.3, 1)';
  const DURATION = 1700;

  const play = () => {
    const w = wall.clientWidth;
    const tw = trowel.offsetWidth;
    // Slanted edge goes from -12%/-24% to 124%/112%; its middle runs -18% → 118%
    const from = -0.18 * w - tw * 0.5;
    const to = 1.18 * w - tw * 0.5;
    const opts = { duration: DURATION, easing: STROKE, fill: 'forwards' as const };

    finish.animate(
      [{ clipPath: 'polygon(0 0, -12% 0, -24% 100%, 0 100%)' }, { clipPath: 'polygon(0 0, 124% 0, 112% 100%, 0 100%)' }],
      opts,
    );
    trowel.animate(
      [
        { transform: `translateX(${from}px)`, opacity: 1 },
        { transform: `translateX(${to}px)`, opacity: 1, offset: 0.92 },
        { transform: `translateX(${to + 24}px)`, opacity: 0 },
      ],
      opts,
    );
    // The hand rocks a little, like pressing the plaster flat
    hand.animate(
      [
        { transform: 'translateY(-58%) rotate(-10deg)' },
        { transform: 'translateY(-42%) rotate(-5deg)' },
        { transform: 'translateY(-56%) rotate(-9deg)' },
        { transform: 'translateY(-46%) rotate(-6deg)' },
        { transform: 'translateY(-50%) rotate(-8deg)' },
      ],
      { duration: DURATION, easing: 'ease-in-out' },
    );
    // One soft sheen across the fresh plaster
    sheen.animate([{ backgroundPosition: '150% 0' }, { backgroundPosition: '-50% 0' }], {
      duration: 1100,
      delay: DURATION - 200,
      easing: 'cubic-bezier(0.55, 0.05, 0.25, 1)',
      fill: 'forwards',
    });
  };

  if (wall.classList.contains('armed')) {
    // Start once the wall is actually on screen
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      setTimeout(play, 250);
    }, { threshold: 0.35 });
    io.observe(wall);
  }
</script>
