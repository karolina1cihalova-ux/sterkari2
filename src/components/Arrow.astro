---
/** Arrow for buttons. It nudges toward where it leads when the button is hovered (see .btn-arrow in global.css). */
interface Props {
  dir?: 'right' | 'down';
  class?: string;
}
const { dir = 'right', class: className = '' } = Astro.props;
---
<span class:list={['btn-arrow', dir === 'down' && 'btn-arrow-down', className]} aria-hidden="true">
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {dir === 'down' ? <path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" /> : <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />}
  </svg>
</span>
