---
/** A generated plaster surface: a shade (base colour) with a structure (light + shadow filter). */
interface Props {
  shade: string;
  structure: string;
  class?: string;
}
const { shade, structure, class: className = '' } = Astro.props;
---
<svg class:list={['wall block h-full w-full', className]} preserveAspectRatio="none" aria-hidden="true">
  <rect width="100%" height="100%" fill={shade} data-base></rect>
  <rect width="100%" height="100%" filter={`url(#t-${structure})`} data-tex></rect>
</svg>
