---
import Arrow from './Arrow.astro';
import { getImage } from 'astro:assets';
import { getSterky } from '../lib/sterky';

// Structures for "O jakou strukturu máte zájem?", each with a small square photo
const sterky = await Promise.all((await getSterky()).map(async (s) => ({
  id: s.id,
  name: s.data.title,
  img: (await getImage({ src: s.data.cover!, width: 200 })).src,
})));

const field = 'w-full rounded-lg border border-[#dad4ca] bg-white px-3.5 py-3 text-base text-ink transition-[border-color,box-shadow] duration-150 focus:border-ink focus:shadow-[0_0_0_3px_rgba(26,26,26,0.08)] focus:outline-none';
const label = 'text-[13px] font-semibold text-ink';
const optional = '<i class="font-normal not-italic text-muted">(nepovinné)</i>';
// Picture tile: the photo gets a terracotta ring when chosen, a dark one on keyboard focus
const tileImg = 'block aspect-square w-full overflow-hidden rounded-lg bg-line outline-2 outline-offset-2 outline-transparent transition-[outline-color] duration-150 peer-checked:outline-accent peer-focus-visible:outline-ink';
---
<section class="bg-paper pb-24 max-[900px]:pb-[72px]" id="kontakt">
  <!-- Same 1 : 2 columns as the FAQ above, so both paper sections share one grid -->
  <div class="wrap grid items-start gap-9 min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] min-[901px]:gap-16">
    <div>
      <div class="sec-head mb-0">
        <h2>Cenová nabídka</h2>
        <p>Napište nám a&nbsp;ozveme se s&nbsp;termíny a&nbsp;detaily.</p>
      </div>
      <div class="mt-7 grid gap-1 rounded-card bg-white p-[22px] shadow-card">
        <b class="text-[17px] text-ink">Showroom Stěrkaři</b>
        <span>Praha, přesnou adresu doplníme</span>
        <span>Vstup po domluvě</span>
      </div>
    </div>

    <form class="grid gap-[18px] rounded-card bg-white p-8 shadow-float max-[560px]:p-[22px]" id="form" novalidate>
      <div class="grid min-w-0 gap-1.5" data-field="name">
        <label class={label} for="name">Jméno a&nbsp;příjmení</label>
        <input class={field} id="name" name="name" autocomplete="name" required />
        <span class="text-[13px] text-accent empty:hidden" aria-live="polite" data-msg></span>
      </div>
      <div class="grid gap-[18px] min-[561px]:grid-cols-2">
        <div class="grid min-w-0 gap-1.5" data-field="email">
          <label class={label} for="email">E-mail</label>
          <input class={field} id="email" name="email" type="email" autocomplete="email" required />
          <span class="text-[13px] text-accent empty:hidden" aria-live="polite" data-msg></span>
        </div>
        <div class="grid min-w-0 gap-1.5" data-field="phone">
          <label class={label} for="phone">Telefon</label>
          <input class={field} id="phone" name="phone" type="tel" autocomplete="tel" required />
          <span class="text-[13px] text-accent empty:hidden" aria-live="polite" data-msg></span>
        </div>
      </div>

      {sterky.length > 0 && (
        <fieldset class="m-0 grid min-w-0 gap-2.5 border-0 p-0">
          <legend class:list={[label, 'mb-2.5 p-0']}>O&nbsp;jakou strukturu máte zájem?</legend>
          <div class="grid grid-cols-3 gap-x-3 gap-y-3.5 min-[561px]:grid-cols-6">
            {sterky.map((s) => (
              <label class="grid cursor-pointer content-start gap-1.5">
                <input class="peer sr-only" type="radio" name="struktura" value={s.name} data-id={s.id} />
                <span class={tileImg}><img src={s.img} alt="" loading="lazy" class="h-full w-full object-cover" /></span>
                <span class="text-[12.5px] leading-tight text-ink peer-checked:font-semibold">{s.name}</span>
              </label>
            ))}
            <label class="grid cursor-pointer content-start gap-1.5">
              <input class="peer sr-only" type="radio" name="struktura" value="Ještě nevím" />
              <span class:list={[tileImg, 'grid place-items-center bg-paper text-2xl font-bold text-muted']} aria-hidden="true">?</span>
              <span class="text-[12.5px] leading-tight text-ink peer-checked:font-semibold">Ještě nevím</span>
            </label>
          </div>
        </fieldset>
      )}

      <div class="grid gap-[18px] min-[561px]:grid-cols-2">
        <div class="grid min-w-0 content-start gap-1.5">
          <label class={label} for="area">Odhadovaný počet metrů čtverečních?</label>
          <div class="relative">
            <input class:list={[field, 'pr-12']} id="area" name="area" inputmode="decimal" placeholder="Např. 25" />
            <span class="pointer-events-none absolute inset-y-0 right-3.5 grid place-items-center text-sm text-muted" aria-hidden="true">m²</span>
          </div>
        </div>
        <div class="grid min-w-0 content-start gap-1.5">
          <label class={label} for="when">Preferovaný termín <Fragment set:html={optional} /></label>
          <select class={field} id="when" name="when">
            <option value="">Vyberte</option>
            <option>Do dvou týdnů</option>
            <option>Do měsíce</option>
            <option>1 až 3 měsíce</option>
            <option>Později</option>
          </select>
        </div>
      </div>
      <div class="grid min-w-0 gap-1.5">
        <label class={label} for="msg">Zpráva <Fragment set:html={optional} /></label>
        <textarea class:list={[field, 'min-h-[110px] resize-y']} id="msg" name="msg" placeholder="Např. jakou stěnu chcete udělat a&nbsp;kde"></textarea>
      </div>
      <button class="btn btn-dark justify-self-start" type="submit">Odeslat rezervaci<Arrow /></button>
      <p class="text-[13px] text-muted">Údaje použijeme jen k&nbsp;domluvě workshopu. Podrobnosti v&nbsp;zásadách ochrany osobních údajů.</p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  // Shown by the Sonner toaster (Notifications.tsx)
  const toast = (detail: { message: string; description?: string; type?: 'success' }) =>
    window.dispatchEvent(new CustomEvent('toast', { detail }));

  // Coming from a structure's page ("Chci se to naučit"): /?stena=oxidace#kontakt preselects it
  const stena = new URLSearchParams(location.search).get('stena');
  if (stena) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="struktura"][data-id="${CSS.escape(stena)}"]`);
    if (radio) radio.checked = true;
  }

  const check = (name: string, test: (v: string) => boolean, msg: string) => {
    const wrap = form.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
    const input = wrap.querySelector('input')!;
    const ok = test(input.value.trim());
    input.classList.toggle('border-accent', !ok);
    wrap.querySelector('[data-msg]')!.textContent = ok ? '' : msg;
    return ok ? null : input;
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const bad = [
      check('name', (v) => v.length > 1, 'Napište prosím své jméno.'),
      check('email', (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v), 'Zkontrolujte prosím e-mail, třeba jana@email.cz.'),
      check('phone', (v) => v.replace(/\D/g, '').length >= 9, 'Napište prosím telefon, třeba 777 123 456.'),
    ].filter(Boolean);
    if (bad.length) { bad[0]!.focus(); return; }
    // TODO: send to the backend (e.g. Resend) once it exists
    const first = (form.elements.namedItem('name') as HTMLInputElement).value.trim().split(' ')[0];
    toast({ type: 'success', message: `Děkujeme, ${first}!`, description: 'Ukázka: formulář zatím nic neodesílá.' });
    form.reset();
  });
</script>
