---
import Wall from './Wall.astro';
import { INSPIRACE, STRUCTURES, SHADES } from '../data/sterky';

const structureName = (id: string) => STRUCTURES.find((s) => s.id === id)?.name ?? '';
const cardTitle = (title: string) => {
  const t = title.split(' — ')[1] ?? title;
  return t.charAt(0).toLocaleUpperCase('cs') + t.slice(1);
};
const filters = [
  { room: 'vse', label: 'Vše' },
  { room: 'obyvak', label: 'Obývák' },
  { room: 'koupelna', label: 'Koupelna' },
  { room: 'chodba', label: 'Chodba' },
];
---
<section class="bg-paper py-24 max-[900px]:py-[72px]" id="inspirace">
  <div class="wrap">
    <div class="sec-head">
      <h2>Inspirace</h2>
      <p>Jak stěrka vypadá v&nbsp;obýváku, koupelně nebo na chodbě. Vyberte místnost a&nbsp;nechte se inspirovat.</p>
    </div>

    <div class="mb-7 flex flex-wrap gap-2" role="group" aria-label="Filtrovat podle místnosti" id="filters">
      {filters.map((f, i) => (
        <button class="pill" type="button" data-room={f.room} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
      ))}
    </div>

    <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 min-[561px]:grid-cols-2 min-[901px]:grid-cols-3" id="grid">
      {INSPIRACE.map((it) => (
        <li class="card grid gap-2.5" data-room={it.room}>
          <span class="relative block aspect-[4/3] max-w-full overflow-hidden rounded-card">
            <Wall shade={SHADES[it.shade].hex} structure={it.structure} />
            <span class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-[5px] text-[11px] font-bold tracking-[0.14em] text-ink uppercase">{it.label}</span>
          </span>
          <b class="text-[15.5px] font-semibold text-ink">{cardTitle(it.title)}</b>
          <small class="text-[13px] text-muted">{structureName(it.structure)} · {SHADES[it.shade].name}</small>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-[13px] text-muted">Ilustrační ukázky. Fotky skutečných stěn doplníme.</p>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const filters = document.getElementById('filters')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];

  filters.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest<HTMLButtonElement>('.pill');
    if (!pill || pill.getAttribute('aria-pressed') === 'true') return;
    const room = pill.dataset.room;
    filters.querySelectorAll('.pill').forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
    const shown = cards.filter((c) => {
      const on = room === 'vse' || c.dataset.room === room;
      c.hidden = !on;
      return on;
    });
    // Short stagger on the cards that stay
    if (!reduce) shown.forEach((c, k) => c.animate(
      [{ opacity: 0, transform: 'translateY(8px) scale(0.98)' }, { opacity: 1, transform: 'none' }],
      { duration: 300, delay: k * 50, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' },
    ));
  });
</script>
