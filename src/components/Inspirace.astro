---
import { getCollection } from 'astro:content';
import InstallationCard from './InstallationCard.astro';

// All installations, no filter: browsing by room happens in the Stěrky section
const installations = (await getCollection('inspirace')).sort((a, b) => a.data.order - b.data.order);
---
<section class="py-24 max-[900px]:py-[72px]" id="inspirace">
  <div class="wrap">
    <div class="sec-head mb-7 min-[901px]:mb-9">
      <h2>Inspirace</h2>
    </div>

    <ul class="m-0 grid list-none grid-cols-2 gap-x-3 gap-y-6 p-0 min-[561px]:gap-5 min-[901px]:grid-cols-3" id="grid">
      {installations.map((it) => (
        <li><InstallationCard item={it} /></li>
      ))}
    </ul>
    {installations.some((it) => it.data.sample) && (
      <p class="mt-6 text-[13px] text-muted">Karty s generovanou texturou jsou ilustrační ukázky. Fotky dalších realizací doplníme.</p>
    )}
  </div>
</section>
