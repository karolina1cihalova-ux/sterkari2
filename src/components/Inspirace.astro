---
import Wall from './Wall.astro';
import { INSPIRACE, STRUCTURES, SHADES } from '../data/sterky';

const first = INSPIRACE[0];
const structureName = (id: string) => STRUCTURES.find((s) => s.id === id)?.name ?? '';
const filters = [
  { room: 'vse', label: 'Vše' },
  { room: 'obyvak', label: 'Obývák' },
  { room: 'koupelna', label: 'Koupelna' },
  { room: 'chodba', label: 'Chodba' },
];
---
<section class="bg-paper py-24 max-[900px]:py-[72px]" id="inspirace">
  <div class="wrap">
    <div class="sec-head">
      <h2>Inspirace</h2>
      <p>Před a&nbsp;po. Posuňte jezdec a&nbsp;porovnejte stěnu před stěrkou a&nbsp;po ní.</p>
    </div>

    <div class="mb-7 flex flex-wrap gap-2" role="group" aria-label="Filtrovat podle místnosti" id="filters">
      {filters.map((f, i) => (
        <button class="pill" type="button" data-room={f.room} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
      ))}
    </div>

    <div class="compare relative mb-3.5 aspect-[16/7] max-w-full touch-pan-y overflow-hidden rounded-card max-[900px]:aspect-[4/3]" id="compare">
      <div class="absolute inset-0"><Wall shade="#DCD9D2" structure="plain" class="before-wall" /></div>
      <div class="absolute inset-0" id="cmpAfter"><Wall shade={SHADES[first.shade].hex} structure={first.structure} /></div>
      <div class="pointer-events-none absolute inset-y-0 left-1/2 -ml-px w-0.5 bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.06)]" id="cmpHandle">
        <span class="absolute top-1/2 left-1/2 -mt-5 -ml-5 grid size-10 place-items-center rounded-full bg-white text-ink shadow-[0_4px_14px_rgba(0,0,0,0.18)]">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 4L2 9l5 5M11 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </div>
      <span class="cmp-lbl left-3.5">Před</span>
      <span class="cmp-lbl right-3.5">Po</span>
      <input class="absolute inset-0 m-0 size-full cursor-ew-resize opacity-0" type="range" id="cmpRange" min="0" max="100" value="50" aria-label="Porovnat před a po" />
    </div>
    <div class="mb-9 flex flex-wrap justify-between gap-x-5 gap-y-1.5">
      <b class="text-ink" id="cmpTitle">{first.title}</b>
      <span class="text-[13px] text-muted">Ilustrační ukázky. Fotky skutečných stěn doplníme.</span>
    </div>

    <div class="grid grid-cols-1 gap-5 min-[561px]:grid-cols-2 min-[901px]:grid-cols-3" id="grid">
      {INSPIRACE.map((it, i) => (
        <button class="card grid cursor-pointer gap-2.5 border-0 bg-transparent p-0 text-left" type="button" data-room={it.room} data-index={i} aria-current={i === 0 ? 'true' : 'false'}>
          <span class="ph relative block aspect-[4/3] max-w-full overflow-hidden rounded-card">
            <Wall shade={SHADES[it.shade].hex} structure={it.structure} />
            <span class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-[5px] text-[11px] font-bold tracking-[0.14em] text-ink uppercase">{it.label}</span>
          </span>
          <b class="text-[15.5px] font-semibold text-ink">{it.title.split(' — ')[1]}</b>
          <small class="text-[13px] text-muted">{structureName(it.structure)} · {SHADES[it.shade].name}</small>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  #cmpAfter { clip-path: inset(0 0 0 50%); }
  .cmp-lbl {
    position: absolute; top: 14px; pointer-events: none;
    background: rgb(255 255 255 / 0.92); color: var(--color-ink);
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 6px 12px; border-radius: 999px;
  }
  .compare :global(.before-wall rect + rect) { opacity: 0.7; }
  .card { transition: transform 160ms var(--ease-out-strong); }
  .card:active { transform: scale(0.98); }
  .ph { outline: 2px solid transparent; outline-offset: 3px; transition: outline-color 180ms ease; }
  .card[aria-current='true'] .ph { outline-color: var(--color-accent); }
  @media (prefers-reduced-motion: reduce) { .card:active { transform: none; } }
</style>

<script>
  import { INSPIRACE, SHADES } from '../data/sterky';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const after = document.getElementById('cmpAfter')!;
  const handle = document.getElementById('cmpHandle')!;
  const range = document.getElementById('cmpRange') as HTMLInputElement;
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLButtonElement>('.card')];
  const filters = document.getElementById('filters')!;
  let current = 0;

  // Comparison slider: clip-path only, no extra DOM
  const setSplit = (v: string) => {
    after.style.clipPath = `inset(0 0 0 ${v}%)`;
    handle.style.left = `${v}%`;
  };
  range.addEventListener('input', () => setSplit(range.value));

  const showCompare = (i: number) => {
    current = i;
    const it = INSPIRACE[i];
    after.querySelector('[data-base]')!.setAttribute('fill', SHADES[it.shade].hex);
    after.querySelector('[data-tex]')!.setAttribute('filter', `url(#t-${it.structure})`);
    document.getElementById('cmpTitle')!.textContent = it.title;
    cards.forEach((c, k) => c.setAttribute('aria-current', String(k === i)));
    if (!reduce) {
      after.animate([{ filter: 'blur(6px)', opacity: 0.75 }, { filter: 'blur(0px)', opacity: 1 }], { duration: 280, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
    }
  };

  cards.forEach((c, i) => c.addEventListener('click', () => {
    showCompare(i);
    document.getElementById('compare')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
  }));

  filters.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest<HTMLButtonElement>('.pill');
    if (!pill) return;
    const room = pill.dataset.room;
    filters.querySelectorAll('.pill').forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
    const shown = cards.filter((c) => {
      const on = room === 'vse' || c.dataset.room === room;
      c.hidden = !on;
      return on;
    });
    // Short stagger on the cards that stay
    if (!reduce) shown.forEach((c, k) => c.animate(
      [{ opacity: 0, transform: 'translateY(8px) scale(0.98)' }, { opacity: 1, transform: 'none' }],
      { duration: 300, delay: k * 50, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' },
    ));
    if (room !== 'vse' && INSPIRACE[current].room !== room) {
      const first = INSPIRACE.findIndex((it) => it.room === room);
      if (first > -1) showCompare(first);
    }
  });
</script>
