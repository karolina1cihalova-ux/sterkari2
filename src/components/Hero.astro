---
import Arrow from './Arrow.astro';
import TrowelReveal from './TrowelReveal.astro';

// Line icons (24×24, drawn with the current text colour)
const icons = {
  // clock: one day
  den: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>',
  // two people: small group
  lide: '<circle cx="9" cy="8" r="3.4"/><path d="M2.8 20c0-3.4 2.8-6.2 6.2-6.2s6.2 2.8 6.2 6.2"/><circle cx="17.2" cy="9.2" r="2.6"/><path d="M16.8 14.2c2.6.2 4.6 2.6 4.6 5.3"/>',
  // parcel: material package
  material: '<path d="M3.5 7.6 12 3.2l8.5 4.4v8.8L12 20.8l-8.5-4.4z"/><path d="M3.5 7.6 12 12l8.5-4.4M12 12v8.8M7.8 5.4l8.5 4.4"/>',
  // map pin: Prague showroom
  showroom: '<path d="M12 21s-7-6.1-7-11.4a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.6" r="2.6"/>',
};

const facts = [
  { icon: icons.den, title: '1 den', text: 'typicky 9:00–17:00' },
  { icon: icons.lide, title: 'Max. 6 lidí', text: 'na jeden termín' },
  { icon: icons.material, title: 'Materiál v ceně', text: 'balíček na vaši stěnu' },
  { icon: icons.showroom, title: 'Showroom Praha', text: 'reálná místnost' },
];
---
<section class="bg-paper pt-[72px] max-[560px]:pt-12">
  <div class="wrap">
    <!-- Wide screens: big headline on the left, buttons on the right on the headline's last line -->
    <div class="grid min-w-0 gap-8 max-w-[760px] min-[1140px]:max-w-none min-[1140px]:grid-cols-[auto_minmax(0,1fr)] min-[1140px]:items-end min-[1140px]:gap-16">
        <!-- Grows with the screen: ~52px on a 375px phone, up to 64px on desktop (one sentence per line there) -->
        <h1 class="text-[clamp(40px,calc(14px+10.2vw),60px)] leading-[1.02] font-bold tracking-[-0.03em] min-[1140px]:text-[clamp(52px,calc(24px+2.92vw),64px)] min-[1140px]:whitespace-nowrap">
          Stěrku zvládnete sami.<span class="block text-accent">My vám ukážeme jak.</span>
        </h1>
        <div class="flex flex-wrap gap-3 min-[1140px]:justify-end min-[1140px]:pb-1.5">
          <a class="btn btn-dark" href="#kontakt">Chci na workshop<Arrow /></a>
          <a class="btn btn-dark" href="#jak-to-funguje">Jak to funguje<Arrow dir="down" /></a>
        </div>
    </div>

    <div class="mt-12 max-[560px]:mt-9">
      <TrowelReveal />
    </div>

    <div class="mt-10 grid grid-cols-2 border-t border-line min-[901px]:grid-cols-4">
      {facts.map((f) => (
        <div class="flex min-w-0 items-start gap-3.5 pt-6 pr-5 pb-7 max-[560px]:flex-col max-[560px]:gap-3">
          <span class="grid size-11 flex-none place-items-center rounded-lg bg-white text-accent" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
          </span>
          <span class="grid min-w-0 gap-0.5">
            <b class="text-[17px] font-bold text-ink">{f.title}</b>
            <span class="text-sm">{f.text}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
