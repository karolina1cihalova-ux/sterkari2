---
const included = [
  'Showroom připravený jako reálná místnost',
  'Maximálně 6 účastníků na termín',
  'Materiál a nářadí k dispozici na místě',
  'Občerstvení během dne',
];
const takeaways = [
  'Jistotu v postupu od přípravy po finální vrstvu',
  'Vzorky odstínů pro rozhodnutí doma',
  'Checklist kroků pro vaši stěnu',
  'Kontakt na podporu po workshopu',
];
---
<section class="py-24 max-[900px]:py-[72px]" id="workshop">
  <div class="wrap grid items-start gap-9 min-[901px]:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] min-[901px]:items-stretch min-[901px]:gap-16">
    <div>
      <div class="sec-head mb-0">
        <h2>Workshop ve showroomu</h2>
        <p>Jeden den, malá skupina, reálné podmínky. Žádná teorie: odcházíte s&nbsp;rukama, které už stěrku znají.</p>
      </div>
      <ul class="m-0 mt-7 grid list-none grid-cols-1 gap-x-7 gap-y-3.5 p-0 min-[561px]:grid-cols-2">
        {included.map((item) => (
          <li class="grid grid-cols-[20px_1fr] gap-2.5 text-[15.5px] text-ink">
            <svg class="mt-1" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
    <aside class="flex flex-col gap-4 rounded-card bg-paper p-7 shadow-card min-[901px]:p-8">
      <h3 class="text-xl font-bold">Co si odnesete</h3>
      <ul class="m-0 grid list-none gap-2.5 p-0">
        {takeaways.map((item) => (
          <li class="relative pl-[18px] text-[15.5px] text-ink before:absolute before:top-[0.7em] before:left-0 before:size-1.5 before:rounded-full before:bg-accent">{item}</li>
        ))}
      </ul>
      <p class="mt-auto border-t border-line pt-3.5 text-sm">
        <b class="text-ink">Nejbližší termíny:</b> prosinec 2026 – leden 2027 <span class="text-[13px] text-muted">(ukázka)</span>
      </p>
    </aside>
  </div>
</section>
