<div
  id="toast"
  role="status"
  aria-live="polite"
  class="toast hide fixed left-1/2 z-[90] max-w-[calc(100%-32px)] rounded-[10px] bg-ink px-[18px] py-3 text-[14.5px] text-white shadow-[0_10px_30px_-10px_rgba(0,0,0,0.4)]"
></div>

<style>
  .toast {
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    transform: translate(-50%, 0);
    opacity: 1;
    transition: transform 400ms var(--ease-out-strong), opacity 300ms ease;
  }
  /* Exit is faster than enter */
  .toast.hide {
    transform: translate(-50%, 160%);
    opacity: 0;
    pointer-events: none;
    transition-duration: 220ms, 180ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .toast, .toast.hide { transform: translate(-50%, 0); transition: opacity 200ms ease; }
  }
</style>

<script>
  // Any script can show a message: window.dispatchEvent(new CustomEvent('toast', { detail: 'Text' }))
  const el = document.getElementById('toast')!;
  let timer: number | undefined;
  const hide = () => el.classList.add('hide');
  window.addEventListener('toast', (e) => {
    el.textContent = (e as CustomEvent<string>).detail;
    el.classList.remove('hide');
    clearTimeout(timer);
    timer = window.setTimeout(hide, 3200);
  });
  // Don't let a message expire while the tab is in the background
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) clearTimeout(timer);
    else if (!el.classList.contains('hide')) timer = window.setTimeout(hide, 1600);
  });
</script>
